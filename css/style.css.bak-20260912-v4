/* =========================================
   JWAN DRIVER MOBILE MENU
   ========================================= */

.driver-mobilebar {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 56px;
  padding: 8px 14px;
  position: relative;
  z-index: 1000;
  background: var(--card, #fff);
  border-bottom: 1px solid rgba(0,0,0,.08);
}

.driver-mobile-title {
  font-size: 17px;
}

.driver-menu-btn {
  width: 42px;
  height: 42px;
  padding: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.driver-menu-btn svg {
  width: 26px;
  height: 26px;
  display: block;
}

.driver-menu-overlay {
  position: fixed;
  inset: 0;
  z-index: 1998;
  background: rgba(0,0,0,.45);
}

.driver-menu-overlay[hidden] {
  display: none;
}

.driver-drawer {
  position: fixed;
  top: 0;
  right: 0;
  width: min(310px, 88vw);
  height: 100vh;
  z-index: 1999;
  background: var(--card, #fff);
  box-shadow: -8px 0 30px rgba(0,0,0,.18);
  transform: translateX(105%);
  transition: transform .22s ease;
  overflow-y: auto;
}

.driver-drawer.open {
  transform: translateX(0);
}

.driver-drawer-head {
  min-height: 64px;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(0,0,0,.08);
}

.driver-menu-close {
  width: 40px;
  height: 40px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  font-size: 30px;
  line-height: 1;
  cursor: pointer;
}

.driver-drawer-nav {
  display: flex;
  flex-direction: column;
  padding: 10px;
}

.driver-drawer-nav a {
  display: block;
  padding: 14px 12px;
  border-radius: 10px;
  color: inherit;
  text-decoration: none;
  font-weight: 600;
}

.driver-drawer-nav a:hover,
.driver-drawer-nav a:focus {
  background: rgba(255,193,7,.14);
}

@media (min-width: 769px) {
  .driver-mobilebar {
    display: none;
  }
}

/* Jawan: luggage checkbox stays on one line */
.luggage-inline-group {
  display: flex;
  align-items: center;
}

.luggage-inline {
  display: inline-flex !important;
  align-items: center !important;
  gap: 9px;
  white-space: nowrap;
}

.luggage-inline input {
  margin: 0 !important;
  flex: 0 0 auto;
}
